{% extends 'base.html.twig' %}
{% block title %}Registration Confirmed!{% endblock %}
{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 text-center">
            <div class="card shadow border-0">
                <div class="card-body p-5">
                    <i class="fas fa-check-circle fa-5x mb-4" style="color:var(--ism-gold)"></i>
                    <h2 class="fw-bold" style="color:var(--ism-blue)">Registration Confirmed!</h2>
                    <p class="text-muted">Welcome, <strong>{{ registration.fullName }}</strong>!</p>
                    <div class="alert alert-light border mt-3">
                        <p class="mb-1">Your ticket number:</p>
                        <h4 class="fw-bold" style="color:var(--ism-blue)">{{ registration.ticketNumber }}</h4>
                        <p class="mb-0 text-muted small">{{ registration.summit.city }} · {{ registration.summit.eventDate|date('d. F Y') }}</p>
                    </div>
                    <a href="{{ path('app_ticket_download', { ticketNumber: registration.ticketNumber }) }}"
                       class="btn btn-ism btn-lg mt-3">
                        <i class="fas fa-download"></i> Download PDF Ticket
                    </a>
                    <div class="mt-3">
                        <a href="{{ path('app_home') }}" class="btn btn-outline-secondary">Back to Home</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}