<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}ISM Data Science Summit{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        :root { --ism-blue: #1C3D6E; --ism-gold: #C9A84C; }
        .navbar { background-color: var(--ism-blue) !important; }
        .btn-ism { background-color: var(--ism-gold); color: #fff; border: none; }
        .btn-ism:hover { background-color: #b8963e; color: #fff; }
        .hero-section { background: linear-gradient(135deg, var(--ism-blue) 60%, var(--ism-gold) 100%); color: white; padding: 80px 0; }
        .capacity-bar .progress-bar { background-color: var(--ism-gold); }
        footer { background-color: var(--ism-blue); color: #ccc; padding: 30px 0; margin-top: 60px; }
        .admin-sidebar { background-color: var(--ism-blue); min-height: 100vh; }
        .admin-sidebar a { color: #fff; text-decoration: none; display: block; padding: 8px 0; }
        .admin-sidebar a:hover { color: var(--ism-gold); }
        .table-sortable th a { color: var(--ism-blue); text-decoration: none; font-weight: bold; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
{% block navbar %}
<nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container">
        <a class="navbar-brand fw-bold" href="{{ path('app_home') }}">
            <span style="color: var(--ism-gold)">ISM</span> Data Science Summit
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_register') }}">Register</a></li>
                {% if is_granted('ROLE_ADMIN') %}
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_admin_dashboard') }}"><i class="fas fa-cog"></i> Admin</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_logout') }}">Logout</a></li>
                {% else %}
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_login') }}">Admin Login</a></li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>
{% endblock %}
<main>
    {% for type, messages in app.flashes %}
        {% for msg in messages %}
            <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show m-0 rounded-0">
                <div class="container">{{ msg }}</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}
    {% block body %}{% endblock %}
</main>
<footer>
    <div class="container text-center">
        <p>&copy; {{ "now"|date("Y") }} ISM – International School of Management. All rights reserved.</p>
    </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>